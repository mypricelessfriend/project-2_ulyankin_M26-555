[10.000126123428345,"o","\r\n***Процесс работы с таблицей***"]
[10.00017499923706,"o","\r\nФункции:\r"]
[10.00021481513977,"o","\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r"]
[10.000242948532104,"o","\n<command> list_tables - показать список всех таблиц\r"]
[10.000306606292725,"o","\n<command> drop_table <имя_таблицы> - удалить таблицу\r"]
[10.000362157821655,"o","\n"]
[10.000397205352783,"o","\n***Операции с данными***\r"]
[10.000452041625977,"o","\nФункции:\r"]
[10.000512838363647,"o","\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r"]
[10.000556945800781,"o","\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r"]
[10.000593662261963,"o","\n<command> select from <имя_таблицы> - прочитать все записи.\r"]
[10.000654935836792,"o","\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_ус\r\n\u001b[16;104Hсловия> - обновить запись.\r"]
[10.000711917877197,"o","\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r"]
[10.000784873962402,"o","\n<command> info <имя_таблицы> - вывести информацию о таблице.\r"]
[10.000836372375488,"o","\n"]
[10.0008864402771,"o","\nОбщие команды:\r"]
[10.000927448272705,"o","\n<command> exit - выход из программы\r"]
