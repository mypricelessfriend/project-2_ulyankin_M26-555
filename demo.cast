[14.795109033584595,"o","\r\n***Процесс работы с таблицей***"]
[14.795212268829346,"o","\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r"]
[14.795266151428223,"o","\n<command> drop_table <имя_таблицы> - удалить таблицу\r"]
[14.795291662216187,"o","\n"]
[14.795344352722168,"o","\n***Операции с данными***\r"]
[14.795379400253296,"o","\nФункции:\r"]
[14.795427083969116,"o","\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r"]
[14.795464038848877,"o","\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r"]
[14.795504331588745,"o","\n<command> select from <имя_таблицы> - прочитать все записи.\r"]
[14.795557737350464,"o","\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить зап\r\n\u001b[16;125Hпись.\r"]
[14.795592069625854,"o","\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r"]
[14.795640468597412,"o","\n<command> info <имя_таблицы> - вывести информацию о таблице.\r"]
